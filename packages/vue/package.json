{
	"name": "@levita-js/vue",
	"version": "0.4.0",
	"description": "Vue wrapper for Levita 3D tilt & parallax",
	"type": "module",
	"main": "./dist/index.cjs",
	"module": "./dist/index.mjs",
	"types": "./dist/index.d.mts",
	"exports": {
		".": {
			"import": {
				"types": "./dist/index.d.mts",
				"default": "./dist/index.mjs"
			},
			"require": {
				"types": "./dist/index.d.cts",
				"default": "./dist/index.cjs"
			}
		},
		"./style.css": "./dist/style.css"
	},
	"files": [
		"dist"
	],
	"publishConfig": {
		"access": "public",
		"registry": "https://registry.npmjs.org/"
	},
	"sideEffects": [
		"*.css"
	],
	"scripts": {
		"build": "tsdown && cp ../core/src/style.css dist/style.css",
		"type-check": "vue-tsc --noEmit"
	},
	"peerDependencies": {
		"vue": ">=3.3"
	},
	"dependencies": {
		"levita-js": "workspace:*"
	},
	"devDependencies": {
		"@vue/test-utils": "^2.4.6",
		"tsdown": "^0.20.3",
		"vue": "^3.5.0",
		"vue-tsc": "^2.2.0"
	},
	"license": "MIT",
	"repository": {
		"type": "git",
		"url": "git+https://github.com/Jeromearsene/levita.git",
		"directory": "packages/vue"
	},
	"homepage": "https://github.com/Jeromearsene/levita#readme"
}
