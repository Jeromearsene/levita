{
	"name": "levita-monorepo",
	"private": true,
	"type": "module",
	"scripts": {
		"build": "pnpm -r --filter './packages/*' run build",
		"build:examples": "pnpm -r --filter './examples/*' run build",
		"lint": "biome check . && pnpm lint:md",
		"type-check": "pnpm -r run type-check",
		"lint:md": "markdownlint .",
		"lint:fix": "biome check --write . && markdownlint . --fix",
		"test": "vitest run",
		"bench": "vitest bench",
		"test:visual": "playwright test --grep-invert demo",
		"test:visual:update": "playwright test --grep-invert demo --update-snapshots",
		"test:visual:record": "playwright test --grep demo && ./tests/visual/convert-to-gif.sh",
		"changeset": "changeset",
		"version-packages": "changeset version && git checkout -- examples/ && node scripts/sync-peer-deps.js && node scripts/sync-docs.js",
		"release": "pnpm build && changeset publish",
		"dev": "pnpm build && pnpm --filter levita-demo dev --host",
		"size": "size-limit",
		"size:json": "size-limit --json > size-results.json"
	},
	"volta": {
		"node": "24.19.0",
		"pnpm": "10.5.2",
		"npm": "11.17.0"
	},
	"packageManager": "pnpm@10.5.2",
	"devDependencies": {
		"@angular/platform-browser-dynamic": "^22.1.0",
		"@biomejs/biome": "^2.5.10",
		"@changesets/changelog-github": "^1.0.0",
		"@changesets/cli": "^3.0.1",
		"@playwright/test": "^1.62.1",
		"@size-limit/preset-small-lib": "^13.0.3",
		"happy-dom": "^20.11.6",
		"markdownlint-cli": "^0.49.1",
		"reflect-metadata": "^0.2.2",
		"size-limit": "^13.0.3",
		"typescript": "^7.0.2",
		"vitest": "^4.1.11"
	}
}
